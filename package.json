{
  "name": "chrome-bionic-preview",
  "version": "0.2.3",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Chrome extension for bionic reading and gradient reading on any webpage",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "package": "npm run vendor:check && node scripts/package.mjs",
    "release:check": "npm run test:all && npm audit && npm run package"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^24.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "marked": "18.1.0"
  }
}
